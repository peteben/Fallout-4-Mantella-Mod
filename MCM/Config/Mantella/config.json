{
    "modName": "Mantella",
    "displayName": "Mantella",
    "minMcmVersion": 2,
    "content": [
            {
      "text": "Mantella settings",
      "align": "center",
      "type": "text"
    },
    {
      "type": "spacer"
    }
    ],
    "pages": [
    {
      "pageDisplayName": "Main",
      "content": [
        {
          "text": "Main settings",
          "align": "center",
          "type": "text"
        },
        {
        "type": "section",
        "text": "Settings"
        },
        {
          "type": "text",
          "textFromStringProperty": {
            "form": "Mantella.esp|F99",
            "scriptName": "MantellaRepository",
            "propertyName": "testForMCM"
          },
          "helpFromStringProperty": {
            "form": "Mantella.esp|F99",
            "scriptName": "MantellaRepository",
            "propertyName": "testForMCMhelp"
          }
        },
        {
          "text": "DEBUG: Stop all conversations",
          "type": "button",
          "action": {
              "type": "CallFunction",
              "form": "Mantella.esp|F99",
              "scriptName": "MantellaRepository",
              "function": "StopConversations"
          }
        },
        {
          "text": "DEBUG: Restart Mantella application",
          "type": "button",
          "help": "Restarts Mantella.exe",
          "action": {
              "type": "CallFunction",
              "form": "Mantella.esp|F99",
              "scriptName": "MantellaRepository",
              "function": "RestartMantellaExe"
          }
        },
        {
          "text": "Activation option",
          "type": "switcher",
          "help": "When enabled, adds a conversation option when approaching NPCs",
          "valueOptions": {
              "sourceType": "PropertyValueBool",
              "sourceForm": "Mantella.esp|F99",
              "propertyName": "hasActivatePerk"
          },
          "action": {
              "type": "CallFunction",
              "form": "Mantella.esp|F99",
              "scriptName": "MantellaRepository",
              "function": "setActivatePerk",
              "params": ["{value}"]
          }
        },
        {
            "text": "isFlat",
            "type": "hiddenSwitcher",
            "groupControl": 1,
            "valueOptions": {
                "sourceType": "PropertyValueBool",
                "sourceForm": "Mantella.esp|F99",
                "propertyName": "isFlat"
            }
        },
        {
            "text": "Microphone",
            "type": "switcher",
            "help": "Enables the microphone and speech recognition",
            "groupCondition": 1,
            "valueOptions": {
                "sourceType": "PropertyValueBool",
                "sourceForm": "Mantella.esp|F99",
                "propertyName": "microphoneEnabled"
            }
        },
        {
            "text": "Crosshair tracking",
            "type": "switcher",
            "help": "Enables starting conversation using a hotkey",
            "groupCondition": 1,
            "valueOptions": {
                "sourceType": "PropertyValueBool",
                "sourceForm": "Mantella.esp|F99",
                "propertyName": "allowCrosshairTracking"
            }
        },
        {
          "text": "Advanced settings",
          "type": "switcher",
          "groupControl": 2
        },
        {
          "type": "section",
          "text": "Advanced settings",
            "groupCondition": 2
        },
        {
          "text": "Reset to defaults",
          "type": "button",
          "help": "This will reset all settings to their default values.",
          "groupCondition": 2,
          "action": {
              "type": "CallFunction",
              "form": "Mantella.esp|F99",
              "scriptName": "MantellaRepository",
              "function": "reinitializeVariables"
          }
        },
        {
            "text": "HTTP port",
            "type": "slider",
            "help": "Mantella default is 4999. Change both here and in Mantella web page if collision occurs with another app.",
            "groupCondition": 2,
            "valueOptions": {
                "min": 4999,
                "max": 49999,
                "step": 1,
                "sourceType": "PropertyValueInt",
                "sourceForm": "Mantella.esp|F99",
                "scriptName": "MantellaRepository",
                "propertyName": "Httpport"
            }
        },
        {
            "text": "HTTP timeout (seconds)",
            "type": "slider",
            "help": "Default is 240. Increase to allow more time for LLM or TTS responses.",
            "groupCondition": 2,
            "valueOptions": {
                "min": 60,
                "max": 600,
                "step": 1,
                "sourceType": "PropertyValueInt",
                "sourceForm": "Mantella.esp|F99",
                "scriptName": "MantellaRepository",
                "propertyName": "HTTPTimeOutHolotapeValue"
            }
        },
        {
            "text": "Start tutorial",
            "type": "button",
            "help": "Click this to start the tutorial again.",
            "groupCondition": 2,
            "action": {
              "type": "CallFunction",
              "form": "Mantella.esp|F99",
              "scriptName": "MantellaRepository",
              "function": "ResetTutorial"
            }
        }
      ]
    },
    {
      "pageDisplayName": "Radiants",
      "content": [
        {
          "text": "Radiant settings",
          "align": "center",
          "type": "text"
        },
        {
        "type": "spacer"
        },
        {
            "text": "Radiant conversations",
            "type": "switcher",
            "help": "When enabled, allows NPCs to initiate conversations amongst themselves.",
            "valueOptions": {
                "sourceType": "PropertyValueBool",
                "sourceForm": "Mantella.esp|F99",
                "propertyName": "radiantEnabled"
            }
        },
        {
          "text": "Radiant distance, in meters",
          "type": "slider",
          "help": "How close NPCs need to be to start a conversation",
          "valueOptions": {
              "min": 10.0,
              "max": 150.0,
              "step": 0.1,
              "sourceType": "PropertyValueFloat",
              "sourceForm": "Mantella.esp|F99",
              "propertyName": "radiantDistance"
          }
        },
        {
          "text": "Radiant frequency",
          "type": "slider",
          "help": "Minimum time in seconds, between radiant convesations",
          "valueOptions": {
              "min": 10.0,
              "max": 1800.0,
              "step": 10.0,
              "sourceType": "PropertyValueFloat",
              "sourceForm": "Mantella.esp|F99",
              "propertyName": "radiantFrequency"
          }
        },
        {
          "text": "Check",
          "type": "button",
          "action": {
            "type":"CallFunction",
            "form":"Mantella.esp|F99",
            "scriptName": "MantellaRepository",
            "function": "showRadiantVars"    
          }
        }
      ]
    },
    {
