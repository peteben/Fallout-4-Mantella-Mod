    },
    {
      "pageDisplayName": "Vision",
      "content": [
        {
          "text": "Vision settings",
          "align": "center",
          "type": "text"
        }
      ]
   },
   {
    "pageDisplayName": "Hotkeys",
    "content": [
      {
        "text": "Hotkey settings",
        "align": "center",
        "type": "text"
      },
      {
        "type": "spacer",
        "numLines": 3
      },
      {
        "text": "isFlat",
        "type": "hiddenSwitcher",
        "groupControl": 3,
        "valueOptions": {
            "sourceType": "PropertyValueBool",
            "sourceForm": "Mantella.esp|F99",
            "propertyName": "isFlat"
        }
      },
      {
        "text": "isVR",
        "type": "hiddenSwitcher",
        "groupControl": 4,
        "valueOptions": {
            "sourceType": "PropertyValueBool",
            "sourceForm": "Mantella.esp|F99",
            "propertyName": "isFO4VR"
        }
      },
      {
        "text": "Hotkeys are not available in Fallout 4 VR.",
        "align": "left",
        "type": "text",
        "groupCondition": 4
      },
      {
        "id": "startconversation",
        "text": "Start conversation or add/remove actors",
        "type": "hotkey",
        "groupCondition": 3,
        "help": "Choose the key used to start conversation, or ad and remove actors from conversations."
      },
      {
        "id": "textresponse",
        "text": "Enter player text response for conversation.",
        "type": "hotkey",
        "groupCondition": 3,
        "help": "Choose the key used to enter player dialogue."
      },
      {
        "id": "gameevent",
        "text": "Enter game events",
        "type": "hotkey",
        "groupCondition": 3,
        "help": "Choose the key used to add game events to the conversation."
      },
      {
        "id": "textandvisionresponse",
        "text": "Enter player response and send screenshot",
        "type": "hotkey",
        "groupCondition": 3,
        "help": "Choose the key used to enter player text and send a screenshot."
      },
      {
        "id": "screenshot",
        "text": "Take a screenshot to be sent to the LLM",
        "type": "hotkey",
        "groupCondition": 3,
        "help": "Choose the key used to take a screenshot and send it to the LLM on your next response."
      }
     ]
    },
    {
      "pageDisplayName": "Vanilla dialogue",
      "content": [
        {
          "text": "Vanilla dialogue settings",
          "align": "center",
          "type": "text"
        },
        {
            "type": "spacer"
        },
        {
            "text": "Vanilla dialogue awareness",
            "type": "switcher",
            "help": "When enabled, vanilla dialogue is captured and fed to Mantella when needed.",
            "valueOptions": {
                "sourceType": "PropertyValueBool",
                "sourceForm": "Mantella.esp|F99",
                "propertyName": "allowVanillaDialogue"
            }
        },
        {
          "text": "Stale dialogue expiration (hours)",
          "type": "slider",
          "help": "How long stored dialogue lines are kept in memory before being purged.",
          "valueOptions": {
              "min": 6.0,
              "max": 240.0,
              "step": 1.0,
              "sourceType": "PropertyValueFloat",
              "sourceForm": "Mantella.esp|F99",
              "propertyName": "dialogueExpirationTime"
          }
        }
      ]
    }
    ]
}