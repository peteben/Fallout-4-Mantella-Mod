{
    "modName": "Mantella",
    "keybinds": [
        {
            "id": "startconversation",
            "desc": "Used to start a conversation",
            "action": {
              "type": "CallFunction",
              "form": "Mantella.esp|F99",
              "scriptName": "MantellaRepository",
              "function": "startConversationKey"
            }
        },
        {
            "id": "textresponse",
