              "function": "GetPlayerTextInput",
              "params": ["playerResponseTextEntry"]
            }
        },
        {
            "id": "gameevent",
            "desc": "Enter game events",
            "action": {
              "type": "CallFunction",
              "form": "Mantella.esp|66FBB",
              "scriptName": "MantellaConversation",
              "function": "GetPlayerTextInput",
              "params": ["gameEventEntry"]
            }
        },
        {
            "id": "textandvisionresponse",
            "desc": "Enter text for vision response",
            "action": {
